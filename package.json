    "lint": "eslint  && tsc --noEmit",
    "fix": "eslint  --fix"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "eslint": "^9",
    "eslint-config-shiny-code": "^3",
    "eslint-import-resolver-typescript": "4.1.0",
    "prettier": "^3.6",
    "typescript": "^5"
  }
}
