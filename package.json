{
  "name": "@jeroeng/albus",
  "version": "1.0.0",
  "description": "CLI to help with agentic development in a more deterministic way",
  "license": "MIT",
  "author": "Jeroen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeroen-g/albus.git"
  },
  "bin": { "albus": "./dist/albus" },
  "files": ["dist/albus"],
  "scripts": {
    "build": "bun build src/cli.ts --compile --minify --bytecode --target=bun-darwin-arm64 --outfile dist/albus",
